{
  "name": "serpapi-youtube-audit",
  "version": "0.1.0",
  "private": true,
  "description": "Audit a YouTube channel with SerpApi's YouTube engines, find what performs, and pick one video to remake.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinblanco/serpapi-youtube"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts --dashboard",
    "audit": "tsx cli/audit.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "build:site": "tsx scripts/snapshot.ts serpapi site/index.html --standalone",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
